{
  "version": 2,
  "framework": "nextjs",
  "rootDirectory": "frontend",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "functions": {
    "api/*.py": {
      "runtime": "vercel-python@4.x"
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
